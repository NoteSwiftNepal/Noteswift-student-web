NEXT_PUBLIC_API_URL=http://localhost:5000/api/student
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.noteswift.com.np
# This app's own public URL — used only to resolve absolute OpenGraph/Twitter
# image URLs in src/app/layout.tsx's metadata (Next.js's `metadataBase`).
# Not required in development (falls back to http://localhost:3000). Not set
# here as a real value because this repo has no confirmed production domain
# for the web app itself (only the API's, api.noteswift.com.np) — uncomment
# and fill in once the actual deployed domain is known.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain-here
